{
  "name": "wikisounds",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "build:frontend": "cd frontend && npm install && npm run build",
    "crawl": "npx tsx scripts/crawl-wikipedia.ts",
    "index": "npx tsx scripts/index-corpus.ts",
    "pipeline": "npm run crawl && npm run index"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.61.0",
    "tsx": "^4.19.0",
    "dotenv": "^16.5.0",
    "openai": "^5.0.0",
    "@turbopuffer/turbopuffer": "^0.3.0"
  }
}
